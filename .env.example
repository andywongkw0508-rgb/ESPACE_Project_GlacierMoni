# Optional overrides for local machines.
# Copy the values you need into .env (or export them before running app.py).

# Dataset root containing master_manifest.csv and the sentinel/ subfolder.
# GLACIER_DATA_ROOT=/absolute/path/to/your/data/root

# Optional: needed for the toolbar Sea Level import and download_sea_level.py.
# COPERNICUSMARINE_SERVICE_USERNAME=your_copernicus_marine_email
# COPERNICUSMARINE_SERVICE_PASSWORD=your_copernicus_marine_password

# Optional: needed for NASA HLS S30 validation downloads.
# EARTHDATA_USERNAME=your_nasa_earthdata_username
# EARTHDATA_PASSWORD=your_nasa_earthdata_password
